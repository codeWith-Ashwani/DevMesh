    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "socket.io": "^4.8.4",
    "validator": "^13.15.23"
  },
  "engines": {
